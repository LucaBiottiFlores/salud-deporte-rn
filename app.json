{
  "expo": {
    "name": "KO FIT",
    "slug": "impulso-fit",
    "version": "1.0.4",
    "scheme": "kofit",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "com.kofit.app",
      "versionCode": 4,
      "adaptiveIcon": {
        "backgroundColor": "#101016",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/timer_done.wav"
          ]
        }
      ],
      "expo-web-browser"
    ]
  }
}
